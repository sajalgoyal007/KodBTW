# Git ignore rules for KodBTW Monorepo

# Target build directories
**/target/
**/build/
**/dist/
**/out/

# Node / Frontend
**/node_modules/
**/.pnp/
**/.pnp.js
**/.vite/
frontend/dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java / IDE
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*

# Eclipse / IntelliJ / VS Code
.classpath
.project
.settings/
.idea/
*.iml
*.iws
*.ipr
.vscode/

# Environment files & secrets
.env*
!.env.example
**/.env*
!**/.env.example
!frontend/.env.production
.env
.env.local
.env.*.local
application-local.yml
application-secret.yml

# OS Generated
.DS_Store
Thumbs.db
