# Copy values into your shell or local secret manager; Spring Boot does not load this file automatically.
DB_URL=jdbc:mysql://127.0.0.1:3306/kodbtw?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_local_mysql_user
DB_PASSWORD=replace_with_local_mysql_password
