# Copy this file to .env at the repository root. Spring Boot imports it automatically
# (optional:file:.env) for local development; production should use real environment
# variables or a secret manager instead.
DB_URL=jdbc:mysql://127.0.0.1:3306/kodbtw?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_local_mysql_user
DB_PASSWORD=replace_with_local_mysql_password
JWT_SECRET=generate_a_random_secret_of_at_least_32_bytes
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080

# Email verification (Resend)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=KodBTW <onboarding@resend.dev>
RESEND_BASE_URL=https://api.resend.com
PUBLIC_SITE_URL=http://localhost:5173
EMAIL_VERIFICATION_TOKEN_VALIDITY=PT24H
EMAIL_VERIFICATION_RESEND_COOLDOWN=PT1M

# Multi-platform contest calendar.
# clist.by is the primary aggregated feed for all eight platforms. Leave the
# credentials blank to rely only on the direct public feeds (Codeforces,
# CodeChef, AtCoder, LeetCode, HackerRank and HackerEarth). GFG and Code360 are
# supplied by clist.by only.
CLIST_USERNAME=
CLIST_API_KEY=
CLIST_BASE_URL=https://clist.by/api/v4
CONTEST_SYNC_CRON=0 0 */6 * * *
CONTEST_SYNC_ENABLED=true

# Google OAuth (leave blank to disable Google sign-in)
GOOGLE_OAUTH_CLIENT_ID=
